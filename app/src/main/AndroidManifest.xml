<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:theme="@style/Theme.DoAnNT118"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        tools:targetApi="31">

        <!-- 🟢 WelcomeActivity: chạy đầu tiên -->
        <activity
            android:name=".ui.WelcomeActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 🟡 Các activity khác -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name=".ui.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <activity android:name=".ui.MainBenhNhanActivity" />
        <activity android:name=".ui.MainBacSiActivity" />
        <activity android:name=".ui.MainAdminActivity" />
        <activity android:name=".ui.ChiTietBenhAnActivity" />
        <activity android:name=".ui.XemBenhAnActivity" />
        <activity android:name=".ui.ProfileActivity" />
        <activity android:name=".ui.QuanLyHoSoCaNhan" />
        <activity android:name=".ui.QuanLyLichLamViecActivity" />
        <activity android:name=".ui.ForgotPasswordActivity" />
        <activity android:name=".ui.SettingActivity"/>
        <activity android:name=".ui.DangKyLichKhamActivity" />
        <activity android:name=".ui.DanhSachBacSiActivity" />
        <activity android:name=".ui.ChiTietBacSiActivity" />
        <activity android:name=".ui.XemChiTietLichKhamActivity"
            android:parentActivityName=".ui.QuanLyLichLamViecActivity"
            android:theme="@style/Theme.AppCompat.Light.DarkActionBar" />
        <activity android:name=".ui.XacNhanLichKhamActivity" />
        <activity android:name=".ui.GuiThongBaoActivity" />
        <activity android:name=".ui.ThongBaoActivity" />
        <activity 
            android:name=".ui.ChatActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.QuanLyLichLamViecNewActivity" />
        <activity
            android:name=".ui.DanhSachDonThuocActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ChiTietDonThuocActivity"
            android:exported="false" />
        <activity
            android:name=".ui.DanhSachHoaDonActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ChiTietHoaDonActivity"
            android:exported="false" />
        <activity
            android:name=".ui.UpdateBacSiProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.XacNhanUongThuocActivity"
            android:exported="false" />
        <activity
            android:name=".ui.LichSuUongThuocActivity"
            android:exported="false" />
        <activity
            android:name=".ui.GuiThongBaoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ChiTietThongBaoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.QuanLyBenhAnBacSiActivity"
            android:exported="false" />
        <activity
            android:name=".ui.CapNhatBenhAnActivity"
            android:exported="false" />
        <activity
            android:name=".ui.TaoBenhAnActivity"
            android:exported="false" />
        <activity
            android:name=".ui.KeDonThuocActivity"
            android:exported="false" />

        <!-- Firebase Cloud Messaging Service -->
        <service
            android:name=".service.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Firebase Messaging Metadata -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/colorPrimary" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="medical_notification_channel" />
    </application>
</manifest>
