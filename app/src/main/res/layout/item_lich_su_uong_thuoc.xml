<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:strokeWidth="0dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Gradient Background với hiệu ứng đẹp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/modern_card_background"
        android:padding="20dp">

        <!-- Header với icon và thông tin -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <!-- Icon container với hiệu ứng đẹp -->
            <FrameLayout
                android:id="@+id/iconContainer"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/icon_container_background"
                android:elevation="6dp">

                <ImageView
                    android:id="@+id/ivIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_medication"
                    android:tint="@android:color/white" />

                <!-- Hiệu ứng ring xung quanh icon -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/icon_ring_effect" />
            </FrameLayout>

            <!-- Thông tin chính -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/iconContainer"
                android:layout_marginStart="16dp"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNgayGio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01/12/2024 - Ca sáng"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.01" />

                <TextView
                    android:id="@+id/tvDanhSachThuoc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💊 Đơn thuốc: DT001"
                    android:textSize="15sp"
                    android:textColor="#666666"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Badge thời gian xác nhận -->
            <TextView
                android:id="@+id/tvThoiGian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="✓ 07:30"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/time_badge_modern"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:visibility="gone"
                android:fontFamily="sans-serif-medium"
                android:elevation="2dp" />
        </RelativeLayout>

        <!-- Divider với gradient -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@drawable/gradient_divider"
            android:layout_marginBottom="20dp" />

        <!-- Trạng thái và actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Status với icon -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvTrangThai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱️ Chờ xác nhận"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#FF9800"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/status_background"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </LinearLayout>

            <!-- Action buttons -->
            <LinearLayout
                android:id="@+id/layoutButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBoQua"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="❌ Bỏ qua"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#FF5722"
                    app:strokeColor="#FF3D00"
                    app:strokeWidth="2dp"
                    app:cornerRadius="24dp"
                    android:layout_marginEnd="12dp"
                    android:minWidth="0dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:fontFamily="sans-serif-medium"
                    app:rippleColor="#FF8A65"
                    android:elevation="6dp"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDaUong"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="✅ Đã uống"
                    android:textSize="13sp"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#4CAF50"
                    app:cornerRadius="24dp"
                    android:minWidth="0dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:fontFamily="sans-serif-medium"
                    app:rippleColor="#81C784"
                    android:elevation="8dp"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
