<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/call_background_gradient">

    <!-- Top section with caller info -->
    <LinearLayout
        android:id="@+id/layoutCallerInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- Caller avatar -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivCallerAvatar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_doctor"
            app:civ_border_width="4dp"
            app:civ_border_color="#FFFFFF"
            android:layout_marginBottom="24dp" />

        <!-- Caller name -->
        <TextView
            android:id="@+id/tvCallerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BS. Nguyễn Văn A"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Call status -->
        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đang gọi..."
            android:textColor="#E8F4FD"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <!-- Call duration -->
        <TextView
            android:id="@+id/tvCallDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Bottom control buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="32dp">

        <!-- Mute button -->
        <ImageButton
            android:id="@+id/btnMute"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/call_button_background"
            android:src="@drawable/ic_mic_off"
            android:contentDescription="Tắt tiếng"
            android:scaleType="center"
            android:layout_marginEnd="24dp" />

        <!-- End call button -->
        <ImageButton
            android:id="@+id/btnEndCall"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/end_call_button_background"
            android:src="@drawable/ic_call_end"
            android:contentDescription="Kết thúc cuộc gọi"
            android:scaleType="center"
            android:layout_marginHorizontal="24dp" />

        <!-- Speaker button -->
        <ImageButton
            android:id="@+id/btnSpeaker"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/call_button_background"
            android:src="@drawable/ic_volume_up"
            android:contentDescription="Loa ngoài"
            android:scaleType="center"
            android:layout_marginStart="24dp" />

    </LinearLayout>

</RelativeLayout>
