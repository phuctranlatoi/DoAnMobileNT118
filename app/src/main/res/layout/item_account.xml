<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTenDangNhap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên đăng nhập: "
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHoTen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Họ tên: "
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email: "
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvVaiTro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vai trò: "
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvTrangThai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trạng thái: "
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvBangCap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bằng cấp: "
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvHocVi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Học vị: "
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvChungChi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chứng chỉ: "
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvTrangThaiXacThuc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trạng thái xác thực: "
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnApprove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Duyệt"
                android:backgroundTint="#28A745"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnReject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Từ chối"
                android:backgroundTint="#DC3545"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sửa"
                android:backgroundTint="#007BFF"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnLock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khóa/Mở khóa"
                android:backgroundTint="#FFC107"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>