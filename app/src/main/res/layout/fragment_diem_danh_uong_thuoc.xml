<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Header Card đẹp và hiện đại -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/modern_header_background"
            android:padding="32dp"
            android:layout_marginBottom="24dp">

            <!-- Tiêu đề chính -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Điểm danh uống thuốc"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                android:layout_gravity="center"
                android:layout_marginBottom="8dp" />

            <!-- Ngày hiện tại - to và rõ ràng -->
            <TextView
                android:id="@+id/tvNgayHomNay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thứ Sáu, 14/12/2025"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#E8F4FD"
                android:fontFamily="sans-serif"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- Hướng dẫn -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xác nhận đã uống hết tất cả thuốc trong mỗi ca"
                android:textSize="16sp"
                android:textColor="#B3D9F2"
                android:fontFamily="sans-serif"
                android:layout_gravity="center"
                android:gravity="center" />

        </LinearLayout>

        <!-- Danh sách các ca uống thuốc -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCacCaUongThuoc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- Empty State đẹp -->
        <LinearLayout
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="40dp"
            android:background="@drawable/empty_state_background"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Không có ca uống thuốc nào hôm nay"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#4A5568"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Không có thuốc nào được kê cho hôm nay"
                android:textSize="16sp"
                android:textColor="#718096"
                android:gravity="center" />

        </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Modern Loading với hiệu ứng -->
    <FrameLayout
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80FFFFFF"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="#667EEA" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Đang tải..."
                android:textSize="16sp"
                android:textColor="#4A5568"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
